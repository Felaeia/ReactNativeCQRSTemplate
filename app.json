{
  "expo": {
    "name": "React Native CQRS Template",
    "slug": "react-native-cqrs-template",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "react-native-cqrs-template",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.reactnativecqrstemplate"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.example.reactnativecqrstemplate"
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router", "expo-splash-screen"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}